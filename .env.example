# Copy to .env and fill in real values. .env is git-ignored.

# Which API to use. The preset sets the base URL and the matching Nemotron model IDs.
#   nvidia_build -> https://integrate.api.nvidia.com/v1 (key from build.nvidia.com)
#   nebius       -> https://api.tokenfactory.nebius.com/v1/ (key from tokenfactory.nebius.com)
PROVIDER=nebius

# Required: API key for the chosen provider. (NEBIUS_API_KEY is accepted as a fallback.)
LLM_API_KEY=

# Optional: override the preset's base URL (e.g. a Nebius regional or dedicated endpoint).
# Must belong to the same provider as PROVIDER. (NEBIUS_BASE_URL is accepted as a fallback.)
# LLM_BASE_URL=

# Model used when chat() gets model=None: nano, super, ultra, or a full model ID.
# If nano returns 404 or 503, calls fall back to super automatically.
NEMOTRON_DEFAULT_MODEL=super

# Optional: override a preset's model ID, e.g. when a newer one ships.
# NEMOTRON_NANO_MODEL=
# NEMOTRON_SUPER_MODEL=
# NEMOTRON_ULTRA_MODEL=

# Where the agent stores long-term memory (relative to the project root).
MEMORY_DIR=memory/data

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
